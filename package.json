{
  "name": "grader-app",
  "version": "1.0.0",
  "private": true,
  "description": "Checks deployed IGM Rich Media Web App Dev II assignments against their rubrics.",
  "homepage": "https://github.com/TB516/grader-app",
  "author": "Thomas",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && effect-language-service diagnostics --project tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "build": "pnpm typecheck && electron-vite build",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
